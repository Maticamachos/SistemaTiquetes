@model STP.DataAccess.STP_ESTADO

@{
    ViewBag.Title = "Editar Estado";
}

<main class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                @using (Html.BeginForm("Edit", "Estados", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ESTADO_ID)
                    <div class="card-header bg-dark text-white">
                        <h1 class="h4 mb-0">Editar Estado</h1>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Nombre del Estado</label>
                            @Html.TextBoxFor(m => m.NOMBRE_ESTADO, new { @class = "form-control", required = "required" })
                        </div>
                    </div>
                    <div class="card-footer text-end">
                        @Html.ActionLink("Cancelar", "Index", "Estados", null, new { @class = "btn btn-outline-dark btn-sm" })
                        <button type="submit" class="btn btn-primary btn-sm">Guardar Cambios</button>
                    </div>
                }
            </div>
        </div>
    </div>
</main>