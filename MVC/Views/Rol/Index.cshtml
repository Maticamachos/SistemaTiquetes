@model IEnumerable<STP.DataAccess.STP_ROL>

@{
    ViewBag.Title = "Gestión de Roles";
    var roles = Model != null ? Model.ToList() : new List<STP.DataAccess.STP_ROL>();
}

<main class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">Catálogo de Roles</h1>
            <p class="text-muted mb-0">Total de registros: @roles.Count</p>
        </div>
        <div>
            @Html.ActionLink("Agregar Nuevo Rol", "Create", "Roles", null, new { @class = "btn btn-primary btn-sm" })
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["Mensaje"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    @if (!roles.Any())
    {
        <div class="alert alert-warning" role="alert">
            No hay registros disponibles en este momento.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Descripción</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rol in roles)
                    {
                        <tr>
                            <td>@rol.ROL_ID</td>
                            <td>@rol.NOMBRE</td>
                            <td>@rol.DESCRIPCION</td>
                            <td class="text-end">
                                @Html.ActionLink("Detalle", "Details", "Roles", new { id = rol.ROL_ID }, new { @class = "btn btn-dark btn-sm" })
                                @Html.ActionLink("Editar", "Edit", "Roles", new { id = rol.ROL_ID }, new { @class = "btn btn-secondary btn-sm" })
                                @Html.ActionLink("Eliminar", "Delete", "Roles", new { id = rol.ROL_ID }, new { @class = "btn btn-danger btn-sm" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>