@model STP.DataAccess.STP_ROL

@{
    ViewBag.Title = "Eliminar Rol";
}

<main class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                @using (Html.BeginForm("Delete", "Roles", new { id = Model.ROL_ID }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="card-header bg-danger text-white">
                        <h1 class="h4 mb-0">Confirmar Eliminación</h1>
                    </div>
                    <div class="card-body">
                        <p>¿Está seguro de que desea eliminar el registro: <strong>@Model.NOMBRE</strong>?</p>
                        <p class="text-muted small">Esta acción no se puede deshacer</p>
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Descripción:</dt>
                            <dd class="col-sm-8">@Model.DESCRIPCION</dd>
                        </dl>
                    </div>
                    <div class="card-footer text-end">
                        @Html.ActionLink("Cancelar", "Index", "Roles", null, new { @class = "btn btn-outline-dark btn-sm" })
                        <button type="submit" class="btn btn-danger btn-sm">Sí Eliminar</button>
                    </div>
                }
            </div>
        </div>
    </div>
</main>