@model MVC.Models.LoginViewModel

@{
    ViewBag.Title = "Iniciar sesión";
}

<style>
    .login-container {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px 16px;
    }

    .login-card {
        width: 100%;
        max-width: 440px;
        padding: 36px;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        box-shadow: 0 12px 35px rgba(15, 23, 42, .08);
    }

    .login-brand {
        color: #2563eb;
        font-size: .85rem;
        font-weight: 700;
        letter-spacing: 2px;
        margin-bottom: 16px;
    }

    .login-card h1 {
        color: #0f172a;
        font-size: 1.9rem;
        font-weight: 700;
    }

    .login-description {
        color: #64748b;
        margin-bottom: 28px;
    }

    .login-card .form-control {
        min-height: 46px;
        max-width: none;
        border-radius: 8px;
    }

    .login-card .btn {
        min-height: 46px;
        border-radius: 8px;
        font-weight: 600;
    }

    .login-note {
        margin-top: 24px;
        color: #64748b;
        font-size: .85rem;
        text-align: center;
    }
</style>

<div class="login-container">
    <section class="login-card" aria-labelledby="login-title">
        <div class="login-brand">SISTEMA DE TIQUETES</div>

        <h1 id="login-title">Bienvenido</h1>

        <p class="login-description">
            Ingresá tus datos para acceder a tu cuenta.
        </p>

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-info" role="status">
                @ViewBag.Mensaje
            </div>
        }

        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                          true, "", new { @class = "text-danger" })

            <div class="mb-3">
                @Html.LabelFor(
                              m => m.Email,
                              new { @class = "form-label" })

                @Html.TextBoxFor(
                              m => m.Email,
                              new
                              {
                                  @class = "form-control",
                                  type = "email",
                                  placeholder = "nombre@correo.com",
                                  autocomplete = "username"
                              })

                @Html.ValidationMessageFor(
                              m => m.Email, "",
                              new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(
                              m => m.Password,
                              new { @class = "form-label" })

                @Html.PasswordFor(
                              m => m.Password,
                              new
                              {
                                  @class = "form-control",
                                  placeholder = "Tu contraseña",
                                  autocomplete = "current-password"
                              })

                @Html.ValidationMessageFor(
                              m => m.Password, "",
                              new { @class = "text-danger small" })
            </div>

            <div class="form-check mb-4">
                @Html.CheckBoxFor(
                              m => m.RememberMe,
                              new { @class = "form-check-input" })

                @Html.LabelFor(
                              m => m.RememberMe,
                              new { @class = "form-check-label" })
            </div>

            <button type="submit" class="btn btn-primary w-100">
                Iniciar sesión
            </button>
        }

        <p class="login-note">
        <p class="text-center mt-4">
            ¿No tenés cuenta?
            @Html.ActionLink("Registrate", "Register", "Account")
        </p>
        Vista de demostración. El acceso todavía no está conectado.
        </p>
    </section>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}